{
  "name": "dsh-gemini-aistudio",
  "version": "0.1.1",
  "description": "Native Gemini provider for DeepSeek Harness, with PDF path attachments and Google Search grounding.",
  "private": false,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./request": "./lib/request.js",
    "./pdf": "./lib/pdf.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jyleaves/dsh-gemini-aistudio.git"
  },
  "bugs": {
    "url": "https://github.com/Jyleaves/dsh-gemini-aistudio/issues"
  },
  "homepage": "https://github.com/Jyleaves/dsh-gemini-aistudio#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-slots"],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2 <1",
    "react": "^18.2.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "update-dsh-gemini-aistudio.ps1",
    "update-dsh-gemini-aistudio.bat"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js"
  }
}
